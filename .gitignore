# Task index (generated)
data/task_index/

# OMJ competition materials - NOT redistributed with this repository (see NOTICE).
# They belong to Stowarzyszenie na rzecz Edukacji Matematycznej (omj.edu.pl).
# Recreate locally with: python download_tasks.py --all-etaps
tasks/*
!tasks/.gitkeep

# Task statements (title + content) transcribed from those PDFs - same owner,
# same rule. Recreate locally with: python fix_latex_content.py --all
data/task_content/*
!data/task_content/.gitkeep

# Synthetic task corpus for the e2e stack (regenerated by e2e/run-e2e.sh)
e2e/fixtures/task_corpus/

