# Production Environment Variables for Docker Compose
# Copy to .env.prod and fill in values before deployment:
#   cp .env.prod.example .env.prod
#
# Run with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# =============================================================================
# Database (required)
# =============================================================================
POSTGRES_USER=omj
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=omj

# =============================================================================
# Authentication (required for production)
# =============================================================================
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=CHANGE_ME_64_CHAR_HEX_STRING

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Set to true only for testing without auth
AUTH_DISABLED=false

# =============================================================================
# Access Control (choose one method)
# =============================================================================
# Option 1: Email allowlist (simplest)
ALLOWED_EMAILS=user1@gmail.com,user2@example.com

# Option 2: Google Groups (requires Workspace Admin setup)
# GOOGLE_GROUP_EMAIL=your-group@googlegroups.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# =============================================================================
# AI Provider (required)
# =============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90

# Anthropic (Claude) - optional second provider. The active provider/model is
# chosen at runtime in /admin/settings (stored in the app_settings table);
# GEMINI_MODEL above is only the default used until an admin saves a choice.
# AI_PROVIDER accepts only "gemini" (anything else is ignored with a warning).
# ANTHROPIC_PROCESSOR_APPROVED is the GDPR gate: keep it false until Anthropic
# is signed off as a processor (DPA, DPIA, regulamin) - while false no student
# data is sent to Anthropic and Claude models cannot be selected.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_EFFORT=high          # grading (output_config.effort)
# ANTHROPIC_EFFORT_AUX=medium    # extraction, hints, patterns
# ANTHROPIC_TIMEOUT=180          # seconds, wall clock per call
# ANTHROPIC_PROCESSOR_APPROVED=false

# Automatic failover: when the active provider cannot serve a call (revoked or
# invalid key, 403/404, 429, 502/503/504, no connection) the call is retried
# once on AI_FAILOVER_MODEL. Only through the GDPR gate above: with no
# ANTHROPIC_API_KEY or ANTHROPIC_PROCESSOR_APPROVED=false nothing fails over.
# Never on a safety block, an abuse verdict or an unreadable answer; timeouts
# and 500s only count toward the breaker. After a key/model error (or
# THRESHOLD transient errors in a row across requests) every call goes to the
# backup for BREAKER_MINUTES; one Telegram alert per opening.
# AI_FAILOVER_ENABLED=true
# AI_FAILOVER_MODEL=claude-opus-5-5   # a model from app/ai/models_catalog.py
# AI_FAILOVER_BREAKER_MINUTES=15
# AI_FAILOVER_BREAKER_THRESHOLD=3

# Global brakes: estimated AI spend in a rolling 24 h (USD, 0 = off; Telegram
# alert at 80% and 100%) and gradings calling the model at once (the rest wait
# as "pending" for at most AI_GRADING_QUEUE_TIMEOUT seconds).
# AI_DAILY_SPEND_LIMIT_USD=25
# AI_GRADING_MAX_CONCURRENT=4
# AI_GRADING_QUEUE_TIMEOUT=300

# =============================================================================
# Data Retention (RODO art. 5(1)(e) - storage limitation)
# =============================================================================
# Users are children; nothing may be kept indefinitely. Defaults below match
# app/config.py. Setting either to 0 disables that pass - do not do that here.
RETENTION_SUBMISSION_MONTHS=24
RETENTION_SCORING_THINKING_DAYS=90
# Accounts with no login and no submission for this long are deleted entirely
RETENTION_INACTIVE_ACCOUNT_MONTHS=36
# Admin access audit trail (RODO art. 5(2))
RETENTION_ADMIN_AUDIT_MONTHS=12
# The production image runs a single gunicorn worker, so the in-app daily run is
# safe. Set to false and use cron + scripts/purge_expired_data.py if you scale out.
RETENTION_AUTO_PURGE=true

# =============================================================================
# Transactional e-mail (parent consent, password reset, parent page links)
# =============================================================================
# Resend, domain omj-validator.pl verified, sending region eu-west-1.
# Without a working key nobody under 16 can get an account confirmed.
EMAIL_BACKEND=resend
RESEND_API_KEY=re_...
# EMAIL_FROM=Trener OMJ <noreply@omj-validator.pl>
# EMAIL_REPLY_TO=kontakt@omj-validator.pl
# Absolute links in e-mails (and the e-mail logo) are built from this
# PUBLIC_BASE_URL=https://omj-validator.pl
# Date of the /regulamin text stored with each consent; bump it together with
# LAST_UPDATED in frontend/src/app/regulamin/page.tsx
# TERMS_VERSION=2026-10-13

# =============================================================================
# Telegram Notifications (optional)
# =============================================================================
# Disabled unless BOTH values are set. Notifications must never contain a user's
# name or e-mail - see the privacy note in app/notifications.py.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890
# Optional short irreversible pseudonym (leave unset to send no identifier):
# TELEGRAM_PSEUDONYM_SALT=generate-with-openssl-rand-hex-32
