# OMJ Validator Development Environment
# Copy this to .env and fill in the required values

# =============================================================================
# REQUIRED
# =============================================================================

# AI Provider - Gemini API key is required
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90

# =============================================================================
# AUTHENTICATION (optional for local dev)
# =============================================================================

# Disable authentication for local development (Google OAuth requires external URL)
AUTH_DISABLED=true

# Session secret (generate for production: openssl rand -hex 32)
SESSION_SECRET_KEY=generate-with-openssl-rand-hex-32

# Google OAuth (required when AUTH_DISABLED=false)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# ACCESS CONTROL (required when AUTH_DISABLED=false)
# =============================================================================

# Option 1: Email allowlist (simplest - comma-separated list)
# ALLOWED_EMAILS=user1@gmail.com,user2@example.com

# Option 2: Google Groups API (requires Workspace Admin + Domain-Wide Delegation)
# GOOGLE_GROUP_EMAIL=your-group@googlegroups.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# =============================================================================
# APP CONFIGURATION
# =============================================================================

UPLOAD_MAX_SIZE_MB=10

# =============================================================================
# DATA RETENTION (RODO art. 5(1)(e) - storage limitation)
# =============================================================================
# How long a whole submission (DB row + uploaded photos) is kept.
# 0 = never expire - acceptable ONLY for local dev, never for a public instance.
RETENTION_SUBMISSION_MONTHS=0
# How long the raw AI "thinking" trace (reproduces the student's work) is kept.
RETENTION_SCORING_THINKING_DAYS=0
# Delete accounts with no login and no submission for this many months.
RETENTION_INACTIVE_ACCOUNT_MONTHS=0
# How long the admin access audit trail is kept (RODO art. 5(2)).
RETENTION_ADMIN_AUDIT_MONTHS=0
# Run retention once a day from inside the app (single-worker deployments).
# Set to false and run scripts/purge_expired_data.py from cron when scaling out.
RETENTION_AUTO_PURGE=false

# =============================================================================
# TELEGRAM NOTIFICATIONS (optional)
# =============================================================================
# Submission alerts. Disabled unless BOTH values are set.
# Notifications never contain a user's name or e-mail - see app/notifications.py.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890
# Optional: adds a short irreversible pseudonym so submissions from different
# users can be told apart in the chat. Leave unset to send no identifier at all.
# TELEGRAM_PSEUDONYM_SALT=generate-with-openssl-rand-hex-32

# =============================================================================
# DATABASE (set automatically by docker-compose.yml)
# =============================================================================
# Only uncomment if running backend outside of Docker:
# DATABASE_URL=postgresql://omj:omj@localhost:5433/omj
