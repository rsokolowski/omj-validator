# OMJ Validator Development Environment
# Copy this to .env and fill in the required values

# =============================================================================
# REQUIRED
# =============================================================================

# AI Provider - Gemini API key is required
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=90

# Anthropic (Claude) - optional second provider. The active provider/model is
# chosen at runtime in /admin/settings (stored in the app_settings table);
# GEMINI_MODEL above is only the default used until an admin saves a choice.
# AI_PROVIDER accepts only "gemini" (anything else is ignored with a warning).
# ANTHROPIC_PROCESSOR_APPROVED is the GDPR gate: keep it false until Anthropic
# is signed off as a processor (DPA, DPIA, regulamin) - while false no student
# data is sent to Anthropic and Claude models cannot be selected.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_EFFORT=high          # grading (output_config.effort)
# ANTHROPIC_EFFORT_AUX=medium    # extraction, hints, patterns
# ANTHROPIC_TIMEOUT=180          # seconds, wall clock per call
# ANTHROPIC_PROCESSOR_APPROVED=false

# =============================================================================
# AUTHENTICATION (optional for local dev)
# =============================================================================

# Disable authentication for local development (Google OAuth requires external URL)
AUTH_DISABLED=true

# Session secret (generate for production: openssl rand -hex 32)
SESSION_SECRET_KEY=generate-with-openssl-rand-hex-32

# Google OAuth (required when AUTH_DISABLED=false)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# ACCESS CONTROL (required when AUTH_DISABLED=false)
# =============================================================================

# Option 1: Email allowlist (simplest - comma-separated list)
# ALLOWED_EMAILS=user1@gmail.com,user2@example.com

# Option 2: Google Groups API (requires Workspace Admin + Domain-Wide Delegation)
# GOOGLE_GROUP_EMAIL=your-group@googlegroups.com
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# =============================================================================
# APP CONFIGURATION
# =============================================================================

UPLOAD_MAX_SIZE_MB=10

# Private tasks ("Moje zadania") - daily limits on the AI calls made while
# creating tasks (grading shares RATE_LIMIT_SUBMISSIONS_*). Allowlisted users
# are not limited.
# RATE_LIMIT_PRIVATE_TASKS_PER_USER_PER_DAY=10
# RATE_LIMIT_PRIVATE_EXTRACTS_PER_USER_PER_DAY=15
# RATE_LIMIT_AI_USAGE_GLOBAL_PER_DAY=1000
# PRIVATE_ABUSE_THRESHOLD=70

# Patterns ("Wzorce") - daily limits on AI calls while writing a pattern
# (recall reviews make none). They count toward RATE_LIMIT_AI_USAGE_GLOBAL_PER_DAY.
# RATE_LIMIT_PATTERN_REFINES_PER_USER_PER_DAY=30
# RATE_LIMIT_PATTERN_SUGGESTS_PER_USER_PER_DAY=10
# RATE_LIMIT_PATTERN_LINKS_PER_USER_PER_DAY=10

# =============================================================================
# DATA RETENTION (RODO art. 5(1)(e) - storage limitation)
# =============================================================================
# How long a whole submission (DB row + uploaded photos) is kept.
# 0 = never expire - acceptable ONLY for local dev, never for a public instance.
RETENTION_SUBMISSION_MONTHS=0
# How long the raw AI "thinking" trace (reproduces the student's work) is kept.
RETENTION_SCORING_THINKING_DAYS=0
# Delete accounts with no login and no submission for this many months.
RETENTION_INACTIVE_ACCOUNT_MONTHS=0
# How long the admin access audit trail is kept (RODO art. 5(2)).
RETENTION_ADMIN_AUDIT_MONTHS=0
# Private tasks ("Moje zadania") are deleted this long after their last activity.
RETENTION_PRIVATE_TASK_MONTHS=0
# Patterns ("Wzorce") are deleted this long after their last activity.
RETENTION_PATTERN_MONTHS=0
# How long the content-free log of non-submission AI calls (ai_usage) is kept.
RETENTION_AI_USAGE_DAYS=0
# Run retention once a day from inside the app (single-worker deployments).
# Set to false and run scripts/purge_expired_data.py from cron when scaling out.
RETENTION_AUTO_PURGE=false

# =============================================================================
# TELEGRAM NOTIFICATIONS (optional)
# =============================================================================
# Submission alerts. Disabled unless BOTH values are set.
# Production only: docker-compose.yml (dev) ignores these and reads
# DEV_TELEGRAM_BOT_TOKEN / DEV_TELEGRAM_CHAT_ID instead, so local test
# submissions never reach the production chat.
# Notifications never contain a user's name or e-mail - see app/notifications.py.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890
# Optional: adds a short irreversible pseudonym so submissions from different
# users can be told apart in the chat. Leave unset to send no identifier at all.
# TELEGRAM_PSEUDONYM_SALT=generate-with-openssl-rand-hex-32

# =============================================================================
# DATABASE (set automatically by docker-compose.yml)
# =============================================================================
# Only uncomment if running backend outside of Docker:
# DATABASE_URL=postgresql://omj:omj@localhost:5433/omj
